+func TestFallbackDynamicDelayThresholds(t *testing.T) {
+	pLow := newMockProxy("low")
+	pLow.lastDelay.Store(100)
+	pMid := newMockProxy("mid")
+	pMid.lastDelay.Store(1000)
+	pHigh := newMockProxy("high")
+	pHigh.lastDelay.Store(4000)
+
+	fb, _ := NewFallback(GroupCommonOption{Name: "dyn"}, FallbackOption{}, pLow, []P.ProxyProvider{&mockProvider{proxies: []C.Proxy{pLow, pMid, pHigh}}})
+
+	if got := fb.staggerDelayForProxy(pLow); got != 1500*time.Millisecond {
+		t.Fatalf("low delay stagger expected 1.5s, got %v", got)
+	}
+	if got := fb.staggerDelayForProxy(pMid); got != 2000*time.Millisecond {
+		t.Fatalf("mid delay stagger expected 2s, got %v", got)
+	}
+	if got := fb.staggerDelayForProxy(pHigh); got != 3000*time.Millisecond {
+		t.Fatalf("high delay stagger expected 3s cap, got %v", got)
+	}
+
+	if got := fb.stallTimeoutForProxy(pLow); got != 4*time.Second {
+		t.Fatalf("low delay stall expected 4s, got %v", got)
+	}
+	if got := fb.stallTimeoutForProxy(pMid); got != 5*time.Second {
+		t.Fatalf("mid delay stall expected 5s, got %v", got)
+	}
+	if got := fb.stallTimeoutForProxy(pHigh); got != 10*time.Second {
+		t.Fatalf("high delay stall expected 10s cap, got %v", got)
+	}
+}
