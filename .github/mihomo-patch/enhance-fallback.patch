new file mode 100644
--- /dev/null
+++ b/adapter/outboundgroup/fallback_health.go
@@ -0,0 +1,111 @@
+package outboundgroup
+
+import (
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/provider"
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel/statistic"
+
+	"golang.org/x/exp/slices"
+)
+
+func init() {
+	provider.HealthCheckUpdated.Register(sampleIdleProviderHealth)
+}
+
+type idleHealthSample struct {
+	conn     C.Conn
+	observer *fallbackObservation
+	progress time.Time
+}
+
+func sampleIdleProviderHealth(updates provider.HealthCheckUpdates) {
+	samples := make(map[time.Duration][]idleHealthSample)
+	statistic.DefaultManager.Range(func(tracker statistic.Tracker) bool {
+		conn, ok := tracker.(C.Conn)
+		if !ok {
+			return true
+		}
+		for value := any(conn); value != nil; {
+			if c, ok := value.(*fallbackObserverConn); ok {
+				o := c.fallbackObservation
+				o.mux.Lock()
+				if o.idleWithProviderFailureLocked(updates) {
+					delay := o.group.effectiveCloseSampleDelay()
+					samples[delay] = append(samples[delay], idleHealthSample{conn, o, o.lastProgress})
+				}
+				o.mux.Unlock()
+			}
+			wrapped, ok := value.(N.WithUpstream)
+			if !ok {
+				break
+			}
+			value = wrapped.Upstream()
+		}
+		return true
+	})
+	for delay, batch := range samples {
+		batch := batch
+		time.AfterFunc(delay, func() {
+			for _, sample := range batch {
+				sample.retire(updates)
+			}
+		})
+	}
+}
+
+func (o *fallbackObservation) idleWithProviderFailureLocked(updates provider.HealthCheckUpdates) bool {
+	if o.closed || o.receiveEnded || !o.idleObserved || len(o.writes) > 0 || len(o.pending) > 0 {
+		return false
+	}
+	f := o.group
+	if o.proxy.AliveForTestUrl(f.testUrl) {
+		return false
+	}
+	match := updates.MatchGroup(f.providers, o.proxy, f.testUrl)
+	if match == nil {
+		return false
+	}
+	members := f.GetProxies(false)
+	if !slices.Contains(members, o.proxy) {
+		return false
+	}
+	failedHere := match(o.proxy, false)
+	f.stateMux.Lock()
+	defer f.stateMux.Unlock()
+	now := time.Now()
+	for _, p := range members {
+		if !failedHere && !match(p, true) {
+			continue
+		}
+		if p == o.proxy || isSkippableAdapter(p.Type()) || f.isDemotedLocked(p, now) || f.affectedLocked(p, o.host, now) {
+			continue
+		}
+		// LastDelayForTestUrl requires a successful check for this exact URL.
+		if delay := p.LastDelayForTestUrl(f.testUrl); delay > 0 && delay < 0xffff {
+			if failedHere {
+				return true
+			}
+			// A peer recovery requires a recorded failure for the group's exact URL.
+			state, ok := o.proxy.ExtraDelayHistories()[f.testUrl]
+			return ok && !state.Alive && len(state.History) > 0 && state.History[len(state.History)-1].Delay == 0
+		}
+	}
+	return false
+}
+
+func (s idleHealthSample) retire(updates provider.HealthCheckUpdates) {
+	o := s.observer
+	o.mux.Lock()
+	if o.lastProgress != s.progress || !o.idleWithProviderFailureLocked(updates) {
+		o.mux.Unlock()
+		return
+	}
+	o.closed = true
+	o.stopTimerLocked()
+	o.mux.Unlock()
+	_ = s.conn.SetWriteDeadline(time.Now())
+	_ = s.conn.Close()
+}
