+func (f *Fallback) reportEvidence(proxy C.Proxy, host string, strong, responsePending bool) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	if host == "" {
+		host = "_unknown_"
+	}
+
+	shouldDemoteMultiHost := false
+	shouldProbe := false
+
+	f.stateMux.Lock()
+	st := f.proxyStateLocked(proxy)
+	if st == nil {
+		f.stateMux.Unlock()
+		return
+	}
+	if responsePending && host != "_unknown_" {
+		if st.affectedTargets == nil {
+			st.affectedTargets = make(map[string]time.Time)
+		}
+		st.affectedTargets[host] = now
+	}
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	// Only strong signals count toward multi-host demotion; destination evidence is independent.
+	if strong {
+		if st.suspectTargets == nil {
+			st.suspectTargets = make(map[string]time.Time)
+		}
+		st.suspectTargets[host] = now
+		hosts := make(map[string]struct{})
+		for target, ts := range st.suspectTargets {
+			if now.Sub(ts) > fallbackHostWindow {
+				delete(st.suspectTargets, target)
+			} else {
+				hosts[destinationHost(target)] = struct{}{}
+			}
+		}
+		shouldDemoteMultiHost = len(hosts) >= fallbackHostThreshold
+	}
+
+	if !shouldDemoteMultiHost {
+		minGap := f.effectiveProbeGap(strong)
+		switch {
+		case st.probing:
+			st.pendingProbe = true
+			st.pendingStrong = st.pendingStrong || strong
+		case st.lastProbe.IsZero() || now.Sub(st.lastProbe) >= minGap:
+			st.probing = true
+			st.lastProbe = now
+			st.stopProbeTimerLocked()
+			shouldProbe = true
+		default:
+			f.scheduleProbeLocked(st, proxy, st.lastProbe.Add(minGap), strong)
+		}
+	}
+	owner := st
+	f.stateMux.Unlock()
+
+	if shouldDemoteMultiHost {
+		f.demoteProxyIfOwner(proxy, owner, "multiple distinct hosts stalled/failed")
+		return
+	}
+
+	if shouldProbe {
+		f.startProbe(proxy, owner)
+	}
+}
+
+func (f *Fallback) scheduleProbeLocked(st *proxyFailState, proxy C.Proxy, due time.Time, strong bool) {
+	st.pendingStrong = st.pendingStrong || strong
+	if st.probeTimer != nil {
+		if !due.Before(st.probeDue) {
+			return
+		}
+		st.probeTimer.Stop()
+	}
+	st.probeDue = due
+	st.probeGen++
+	gen := st.probeGen
+	owner := st
+	p := proxy
+	st.probeTimer = time.AfterFunc(time.Until(due), func() {
+		f.runDeferredProbe(p, owner, gen)
+	})
+}
+
+func (f *Fallback) runDeferredProbe(proxy C.Proxy, owner *proxyFailState, gen uint64) {
+	if proxy == nil {
+		return
+	}
+	name := proxy.Name()
+	now := time.Now()
+
+	f.stateMux.Lock()
+	st, ok := f.proxyStates[name]
+	if !ok || st != owner || st.probeGen != gen || f.proxyStateLocked(proxy) != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st.probeTimer = nil
+	if now.Before(st.cooldownUntil) {
+		st.pendingProbe = false
+		f.stateMux.Unlock()
+		return
+	}
+	if st.probing {
+		st.pendingProbe = true
+		f.stateMux.Unlock()
+		return
+	}
+	st.probing = true
+	st.pendingProbe = false
+	st.pendingStrong = false
+	st.lastProbe = now
+	f.stateMux.Unlock()
+
+	f.startProbe(proxy, owner)
+}
+
+func (f *Fallback) startProbe(proxy C.Proxy, owner *proxyFailState) {
+	name := proxy.Name()
+	peer := f.findProbePeer(name)
+	go func() {
+		defer func() {
+			f.stateMux.Lock()
+			if st, ok := f.proxyStates[name]; ok && st == owner {
+				st.probing = false
+				if st.pendingProbe && st.probeTimer == nil && !time.Now().Before(st.cooldownUntil) && f.proxyStateLocked(proxy) == owner {
+					st.pendingProbe = false
+					f.scheduleProbeLocked(st, proxy, st.lastProbe.Add(f.effectiveProbeGap(st.pendingStrong)), st.pendingStrong)
+				}
+			}
+			f.stateMux.Unlock()
+		}()
+
+		f.stateMux.Lock()
+		current := f.proxyStates[name] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if !current {
+			return
+		}
+
+		ctx, cancel := context.WithTimeout(context.Background(), f.probeTimeoutForProxy(proxy))
+		defer cancel()
+
+		peerWasAlive := peer != nil && peer.AliveForTestUrl(f.testUrl)
+		errSelf, errPeer := f.probePair(ctx, proxy, peer)
+		// Comparative health results apply to the current proxy instance and state owner.
+		if errSelf != nil && errPeer == nil {
+			f.demoteProxyIfOwner(proxy, owner, "comparative URLTest failed while peer ok: "+errSelf.Error())
+		} else if errSelf != nil && f.findAliveProxy(false) != proxy {
+			go f.closeStalledConnectionsForProxy(proxy, owner)
+		} else if errPeer == nil && !peerWasAlive {
+			statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+				if o := fallbackStateFor(c, f, proxy); o != nil {
+					o.mux.Lock()
+					for key, x := range o.pending {
+						o.scheduleRetirementLocked(key, x)
+					}
+					o.mux.Unlock()
+				}
+				return true
+			})
+		}
+	}()
+}
