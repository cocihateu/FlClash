+func (f *Fallback) stallTimeoutForProxy(proxy C.Proxy) time.Duration {
+	if f.stallTimeout > 0 {
+		return f.stallTimeout
+	}
+	if proxy != nil {
+		if delay := proxy.LastDelayForTestUrl(f.testUrl); delay > 0 && delay < 0xffff {
+			d := 3*time.Duration(delay)*time.Millisecond + 2*time.Second
+			if d < fallbackMinStallThreshold {
+				return fallbackMinStallThreshold
+			}
+			if d > fallbackMaxStallThreshold {
+				return fallbackMaxStallThreshold
+			}
+			return d
+		}
+	}
+	return fallbackMinStallThreshold
+}
+
+func (f *Fallback) staggerDelayForProxy(proxy C.Proxy) time.Duration {
+	if f.staggerDelay > 0 {
+		return f.staggerDelay
+	}
+	if proxy != nil {
+		if delay := proxy.LastDelayForTestUrl(f.testUrl); delay > 0 && delay < 0xffff {
+			d := 2 * time.Duration(delay) * time.Millisecond
+			if d < fallbackMinStaggerDelay {
+				return fallbackMinStaggerDelay
+			}
+			if d > fallbackMaxStaggerDelay {
+				return fallbackMaxStaggerDelay
+			}
+			return d
+		}
+	}
+	return fallbackMinStaggerDelay
+}
+
+func (f *Fallback) probeTimeoutForProxy(proxy C.Proxy) time.Duration {
+	if f.probeTimeout > 0 {
+		return f.probeTimeout
+	}
+	t := f.stallTimeoutForProxy(proxy)
+	if t < fallbackProbeTimeout {
+		return fallbackProbeTimeout
+	}
+	return t
+}
+
+func (f *Fallback) effectiveProbeGap(strong bool) time.Duration {
