+	trStalled := statistic.NewTCPTracker(rawStalled, statistic.DefaultManager, &C.Metadata{Host: "stalled.com"}, nil, 0, 0, true)
+	trActive := statistic.NewTCPTracker(rawActive, statistic.DefaultManager, &C.Metadata{Host: "downloading.com"}, nil, 0, 0, true)
+	trBackup := statistic.NewTCPTracker(rawBackup, statistic.DefaultManager, &C.Metadata{Host: "other.com"}, nil, 0, 0, true)
+	defer trStalled.Close()
+	defer trActive.Close()
+	defer trBackup.Close()
+
+	fb.demoteProxy(primary, "test smart close")
+
+	// Simulate active connection continuing to download bytes during the 60ms sample window
+	time.Sleep(20 * time.Millisecond)
+	trActive.Info().DownloadTotal.Add(4096)
+
+	deadline := time.Now().Add(500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		if rawStalled.closed.Load() {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	if !rawStalled.closed.Load() {
+		t.Fatalf("expected stalled connection (0 download delta) to be closed")
+	}
+	if rawActive.closed.Load() {
+		t.Fatalf("active downloading connection on primary should NOT be closed")
+	}
+	if rawBackup.closed.Load() {
+		t.Fatalf("connection on backup should NOT be closed")
+	}
+}
