+type fallbackObservation struct {
+	group          *Fallback
+	proxy          C.Proxy
+	host           string
+	stallTimeout   time.Duration
+	strongTimeout  bool
+	closeTransport func() error
+	mux            sync.Mutex
+	timer          *time.Timer
+	waiting        bool
+	responded      bool
+	reported       bool
+	closed         bool
+	writing        int
+	writeResponded bool
+	idle           bool
+	lastRead       time.Time
+	receiveEnded   bool
+}
+
+func (o *fallbackObservation) beginWrite(host string) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	o.writing++
+	o.writeResponded = false
+	if !o.waiting && host != "" {
+		o.host = host
+	}
+	o.armWatchdogLocked()
+}
+
+func (o *fallbackObservation) armWatchdogLocked() {
+	if o.waiting {
+		return
+	}
+	o.stopTimerLocked()
+	o.idle = false
+	o.waiting = true
+	o.reported = false
+	o.startTimerLocked()
+}
+
+func (o *fallbackObservation) armIdleLocked() {
+	if o.closed || o.receiveEnded {
+		return
+	}
+	o.idle = true
+	o.lastRead = time.Now()
+	if o.timer == nil {
+		o.startTimerLocked()
+	}
+}
+
+func (o *fallbackObservation) startTimerLocked() {
+	timeout := o.stallTimeout
+	if timeout <= 0 {
+		timeout = fallbackMinStallThreshold
+	}
+	var timer *time.Timer
+	timer = time.AfterFunc(timeout, func() {
+		o.mux.Lock()
+		if o.closed || o.timer != timer {
+			o.mux.Unlock()
+			return
+		}
+		if o.idle {
+			if remaining := timeout - time.Since(o.lastRead); remaining > 0 {
+				timer.Reset(remaining)
+				o.mux.Unlock()
+				return
+			}
+		}
+		o.timer = nil
+		o.reported = true
+		o.group.reportSuspect(o.proxy, o.host, o.strongTimeout && !o.idle)
+		closeWrite := o.writing > 0
+		if closeWrite {
+			o.closed = true
+		}
+		o.mux.Unlock()
+		if closeWrite {
+			_ = o.closeTransport()
+		}
+	})
+	o.timer = timer
+}
+
+func (o *fallbackObservation) endWrite() {
+	o.mux.Lock()
+	if o.writing > 0 {
+		o.writing--
+	}
+	if o.writing == 0 && (o.writeResponded || o.receiveEnded) {
+		o.stopTimerLocked()
+		o.waiting = false
+		o.armIdleLocked()
+	}
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) stopTimerLocked() {
+	if o.timer != nil {
+		o.timer.Stop()
+		o.timer = nil
+	}
+}
+
+func (o *fallbackObservation) markSuccess(host string) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	if host == "" {
+		host = o.host
+	}
+	if o.waiting && host != o.host {
+		o.group.recordProxySuccess(o.proxy, host)
+		return
+	}
+	o.host = host
+	if !o.idle {
+		o.stopTimerLocked()
+	}
+	o.waiting = false
+	o.responded = true
+	o.reported = false
+	o.writeResponded = o.writing > 0
+	o.group.recordProxySuccess(o.proxy, host)
+	if o.writing > 0 {
+		o.armWatchdogLocked()
+	} else {
+		o.armIdleLocked()
+	}
+}
+
+func (o *fallbackObservation) markError(err error) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	o.markErrorLocked(err)
+}
+
+func (o *fallbackObservation) markErrorLocked(err error) {
+	if errors.Is(err, io.EOF) {
+		o.receiveEnded = true
+		if o.writing > 0 {
+			if !o.closed && !o.responded && !o.reported {
+				o.reported = true
+				o.group.reportSuspect(o.proxy, o.host, false)
+			}
+			return
+		}
+	}
+	o.stopTimerLocked()
+	o.waiting = false
+	if err == nil || o.closed || isIgnoredFallbackError(err) || (o.responded && errors.Is(err, io.EOF)) {
+		return
+	}
+	strong := isStrongFallbackError(err)
+	if strong || !o.reported {
+		o.reported = true
+		o.group.reportSuspect(o.proxy, o.host, strong)
+	}
+}
+
+func (o *fallbackObservation) markPacketWriteError(err error, host string) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.waiting && host != o.host {
+		if !o.closed && !isIgnoredFallbackError(err) {
+			o.group.reportSuspect(o.proxy, host, isStrongFallbackError(err))
+		}
+		return
+	}
+	o.host = host
+	o.markErrorLocked(err)
+}
+
+func (o *fallbackObservation) markPacketReadError(err error) {
+	var netErr net.Error
+	if !errors.As(err, &netErr) || !netErr.Timeout() {
+		o.markError(err)
+		return
+	}
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if !o.closed && o.waiting && !o.reported {
+		o.reported = true
+		o.group.reportSuspect(o.proxy, o.host, false)
+	}
+	if o.writing == 0 {
+		o.stopTimerLocked()
+		o.waiting = false
+	}
+}
+
+func (o *fallbackObservation) close() {
+	o.mux.Lock()
+	o.closed = true
+	o.stopTimerLocked()
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) isClosed() bool {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	return o.closed
+}
+
+func (o *fallbackObservation) fallbackState() *fallbackObservation {
+	return o
+}
