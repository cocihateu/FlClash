+func (f *Fallback) probePair(ctx context.Context, self, peer C.Proxy) (errSelf, errPeer error) {
+	if peer == nil {
+		return f.probeProxy(ctx, self), errors.New("peer proxy unavailable")
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		errSelf = f.probeProxy(ctx, self)
+	}()
+	go func() {
+		defer wg.Done()
+		errPeer = f.probeProxy(ctx, peer)
+	}()
+	wg.Wait()
+	return errSelf, errPeer
+}
