+func TestFallbackRateLimitedStrongSignalIsCoalesced(t *testing.T) {
+	primary := newMockProxy("cf-primary")
+	backup := newMockProxy("backup-1")
+	fb := newTestFallback(t, primary, backup)
+	fb.strongProbeGap = 100 * time.Millisecond
+
+	// First strong signal triggers probe that passes
+	fb.reportSuspect(primary, "a.com", true)
+	time.Sleep(30 * time.Millisecond)
+
+	// Node begins stalling right after first probe; second strong signal arrives within strongProbeGap
+	probeErr := errors.New("stalled")
+	primary.urlTestErr.Store(&probeErr)
+	fb.reportSuspect(primary, "b.com", true)
+
+	deadline := time.Now().Add(1 * time.Second)
+	for time.Now().Before(deadline) && fb.Now() != "backup-1" {
+		time.Sleep(15 * time.Millisecond)
+	}
+	if primary.urlTests.Load() < 2 || fb.Now() != "backup-1" {
+		t.Fatalf("rate-limited strong signal was dropped: tests=%d now=%s", primary.urlTests.Load(), fb.Now())
+	}
+}
