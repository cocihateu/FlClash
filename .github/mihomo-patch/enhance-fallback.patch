+type fallbackObserverConn struct {
+	C.Conn
+	group        *Fallback
+	proxy        C.Proxy
+	stallTimeout time.Duration
+	closed       atomic.Bool
+	done         atomic.Bool
+	stalled      atomic.Bool
+	watchdogMux  sync.Mutex
+	lastWrite    time.Time
+	timer        *time.Timer
+	onSuccess    func()
+	onSuspect    func(err error, strong bool)
+}
+
+func (c *fallbackObserverConn) armWatchdog() {
+	if c.done.Load() || c.closed.Load() {
+		return
+	}
+	c.watchdogMux.Lock()
+	defer c.watchdogMux.Unlock()
+	if c.done.Load() || c.closed.Load() {
+		return
+	}
+	c.lastWrite = time.Now()
+	if c.timer != nil {
+		return
+	}
+	timeout := c.stallTimeout
+	if timeout <= 0 {
+		timeout = fallbackMinStallThreshold
+	}
+	c.timer = time.AfterFunc(timeout, func() {
+		c.watchdogMux.Lock()
+		if c.done.Load() || c.closed.Load() || c.timer == nil {
+			c.watchdogMux.Unlock()
+			return
+		}
+		if remaining := timeout - time.Since(c.lastWrite); remaining > 0 {
+			c.timer.Reset(remaining)
+			c.watchdogMux.Unlock()
+			return
+		}
+		c.stalled.Store(true)
+		stalled := c.done.CompareAndSwap(false, true)
+		if !stalled {
+			c.stalled.Store(false)
+		}
+		c.watchdogMux.Unlock()
+		if stalled && c.onSuspect != nil {
+			c.onSuspect(context.DeadlineExceeded, true)
+		}
+	})
+}
+
+func (c *fallbackObserverConn) stopWatchdog() {
+	c.watchdogMux.Lock()
+	if c.timer != nil {
+		c.timer.Stop()
+		c.timer = nil
+	}
+	c.watchdogMux.Unlock()
+}
+
+func (c *fallbackObserverConn) markSuccess() {
+	if c.done.Load() && !c.stalled.Load() {
+		return
+	}
+	success := c.done.CompareAndSwap(false, true)
+	c.stopWatchdog()
+	c.stalled.Store(false)
+	if success && c.onSuccess != nil {
+		c.onSuccess()
+	}
+}
+
+func (c *fallbackObserverConn) markError(err error) {
+	c.stopWatchdog()
+	if err == nil || c.closed.Load() || isIgnoredFallbackError(err) {
+		return
+	}
+	if c.done.CompareAndSwap(false, true) && c.onSuspect != nil {
+		c.onSuspect(err, isStrongFallbackError(err))
+	}
+}
+
+func (c *fallbackObserverConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n > 0 {
+		c.markSuccess()
+	} else if !c.done.Load() && err != nil {
+		c.markError(err)
+	}
+	return n, err
+}
+
+func (c *fallbackObserverConn) ReadBuffer(buffer *buf.Buffer) error {
+	before := buffer.Len()
+	err := c.Conn.ReadBuffer(buffer)
+	if buffer.Len() > before {
+		c.markSuccess()
+	} else if !c.done.Load() && err != nil {
+		c.markError(err)
+	}
+	return err
+}
+
+func (c *fallbackObserverConn) Write(b []byte) (int, error) {
+	n, err := c.Conn.Write(b)
+	if n > 0 {
+		c.armWatchdog()
+	}
+	if !c.done.Load() && err != nil {
+		c.markError(err)
+	}
+	return n, err
+}
+
+func (c *fallbackObserverConn) WriteBuffer(buffer *buf.Buffer) error {
+	dataLen := buffer.Len()
+	err := c.Conn.WriteBuffer(buffer)
+	if err == nil && dataLen > 0 {
+		c.armWatchdog()
+	}
+	if !c.done.Load() && err != nil {
+		c.markError(err)
+	}
+	return err
+}
+
+func (c *fallbackObserverConn) Close() error {
+	c.closed.Store(true)
+	c.stopWatchdog()
+	return c.Conn.Close()
+}
+
+func (c *fallbackObserverConn) ReaderReplaceable() bool {
+	return c.done.Load() && !c.stalled.Load()
+}
+
+func (c *fallbackObserverConn) ReaderPossiblyReplaceable() bool {
+	return !c.ReaderReplaceable()
+}
+
+func (c *fallbackObserverConn) WriterReplaceable() bool {
+	return c.done.Load() && !c.stalled.Load()
+}
+
+func (c *fallbackObserverConn) WriterPossiblyReplaceable() bool {
+	return !c.WriterReplaceable()
+}
+
+func (c *fallbackObserverConn) Upstream() any {
+	return c.Conn
+}
+
+var _ N.ExtendedConn = (*fallbackObserverConn)(nil)
