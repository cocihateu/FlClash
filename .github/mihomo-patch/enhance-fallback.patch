+	fallbackMaxCooldown        = 5 * time.Minute
+	fallbackRecoveryStableTime = 5 * time.Minute
+	fallbackCloseSampleDelay   = 2 * time.Second
+	fallbackStrongProbeGap     = 3 * time.Second
+	fallbackWeakProbeGap       = 15 * time.Second
+	fallbackPruneInterval      = 30 * time.Second
+)
+
+type proxyFailState struct {
+	proxy           C.Proxy
+	suspectTargets  map[string]time.Time
+	affectedTargets map[string]time.Time
+	cooldownUntil   time.Time
+	backoffLevel    int
+	probing         bool
+	pendingProbe    bool
+	pendingStrong   bool
+	probeDue        time.Time
+	lastProbe       time.Time
+	probeTimer      *time.Timer
+	probeGen        uint64
+}
+
+func (st *proxyFailState) stopProbeTimerLocked() {
+	if st.probeTimer != nil {
+		st.probeTimer.Stop()
+		st.probeTimer = nil
+	}
+	st.probeGen++
+	st.pendingProbe = false
+	st.pendingStrong = false
+	st.probeDue = time.Time{}
+}
+
+type fallbackExchange struct {
+	host          string
+	due           time.Time
+	limit         time.Time
+	lastWrite     time.Time
+	repeatedWrite bool
+	possibleReply bool
+	stalled       bool
+	awaiting      bool
+}
+
+func (x *fallbackExchange) advance(due time.Time) {
+	if !x.limit.IsZero() && due.After(x.limit) {
+		due = x.limit
+	}
+	x.due = due
+}
+
+type fallbackWrite struct {
+	key      string
+	host     string
+	started  time.Time
+	exchange *fallbackExchange
+	answered bool
+}
+
+type fallbackObservation struct {
+	group          *Fallback
+	proxy          C.Proxy
+	host           string
+	stallTimeout   time.Duration
+	strongTimeout  bool
+	isolatedUDP    bool
+	closeTransport func() error
+	mux            sync.Mutex
+	timer          *time.Timer
+	pending        map[string]*fallbackExchange
+	addresses      map[string]string
+	domainByPort   map[string]string
+	numericTargets map[string]bool
+	writes         map[*fallbackWrite]struct{}
+	idleDue        time.Time
+	replyUntil     time.Time
+	armedFor       time.Time
+	lastProgress   time.Time
+	lastSuccess    time.Time
+	cleanupPending bool
+	idleObserved   bool
+	idleFailed     bool
+	responded      bool
+	closed         bool
+	receiveEnded   bool
+}
+
+func (o *fallbackObservation) beginWrite(key string, payload bool) *fallbackWrite {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return nil
+	}
+	host := o.host
+	if key != "" {
+		if !o.isolatedUDP || host == "" {
+			host = o.packetDestination(key)
+		}
+		o.rememberTarget(key)
+	}
+	now := time.Now()
+	w := &fallbackWrite{key: key, host: host, started: now}
+	o.writes[w] = struct{}{}
+	responding := o.strongTimeout && now.Before(o.replyUntil)
+	if payload {
+		o.replyUntil = time.Time{}
+	}
+	if payload && !o.receiveEnded {
+		if x := o.pending[key]; x == nil || (x.possibleReply && !responding) {
+			x = &fallbackExchange{host: host, due: now.Add(o.stallTimeout), awaiting: true, possibleReply: responding}
+			if o.strongTimeout {
+				x.limit = now.Add(2 * o.stallTimeout)
+			}
+			o.pending[key] = x
+		} else if !o.strongTimeout && !x.awaiting {
+			x.awaiting, x.due = true, now.Add(o.stallTimeout)
+		}
+		w.exchange = o.pending[key]
+	}
+	o.idleDue = time.Time{}
+	o.idleObserved = false
+	o.idleFailed = false
+	o.armLocked(w.started.Add(o.stallTimeout))
+	return w
+}
+
+func (o *fallbackObservation) armLocked(due time.Time) {
+	if o.closed || due.IsZero() || (o.timer != nil && !due.Before(o.armedFor)) {
+		return
+	}
+	o.stopTimerLocked()
+	var t *time.Timer
+	t = time.AfterFunc(time.Until(due), func() {
+		o.mux.Lock()
+		o.expireLocked(t)
+	})
+	o.timer, o.armedFor = t, due
+}
+
+func (o *fallbackObservation) expireLocked(t *time.Timer) {
+	if o.closed || o.timer != t {
+		o.mux.Unlock()
+		return
+	}
+	o.timer = nil
+	now := time.Now()
+	for w := range o.writes {
+		due := w.started.Add(o.stallTimeout)
+		if !now.Before(due) {
+			o.group.reportEvidence(o.proxy, w.host, o.strongTimeout, true)
+			o.closed = true
+			o.stopTimerLocked()
+			o.mux.Unlock()
+			_ = o.closeTransport()
+			return
+		}
+		o.armLocked(due)
+	}
+	for key, x := range o.pending {
+		if !now.Before(x.due) {
+			if !x.stalled {
+				for w := range o.writes {
+					if w.key == key && !w.answered {
+						x.advance(w.started.Add(o.stallTimeout))
+						break
+					}
+				}
+			}
+			if !now.Before(x.due) {
+				x.stalled, x.awaiting = true, false
+				o.group.reportEvidence(o.proxy, x.host, o.strongTimeout && !o.routeOnlyLocked(x, now), true)
+				o.scheduleRetirementLocked(key, x)
+				x.due = now.Add(o.group.effectiveProbeGap(false))
+			}
+		}
+		o.armLocked(x.due)
+	}
+	if !o.idleDue.IsZero() {
+		if !now.Before(o.idleDue) {
+			o.idleObserved = true
+			o.idleDue = time.Time{}
+			o.group.reportEvidence(o.proxy, o.host, false, false)
+			if o.group.memberDemoted(o.proxy) {
+				o.idleFailed = true
+				go o.retireIdle(o.lastProgress)
+			}
+		}
+		o.armLocked(o.idleDue)
+	}
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) retireIdle(progress time.Time) {
+	time.Sleep(o.group.effectiveCloseSampleDelay())
+	if o.group.memberDemoted(o.proxy) && o.claimStall(progress) {
+		_ = o.closeTransport()
+	}
+}
+
+// A possible reply to a push and an upload still making progress can steer the next dial.
+func (o *fallbackObservation) routeOnlyLocked(x *fallbackExchange, now time.Time) bool {
+	return o.strongTimeout && (x.possibleReply || len(o.writes) > 0 ||
+		(x.repeatedWrite && now.Sub(x.lastWrite) < o.stallTimeout))
+}
+
+func (o *fallbackObservation) scheduleRetirementLocked(key string, x *fallbackExchange) {
+	if !o.closed && x.stalled && !o.cleanupPending && !o.routeOnlyLocked(x, time.Now()) && o.group.alternateFor(o.proxy, x.host, !o.strongTimeout) {
+		o.cleanupPending = true
+		go o.retireStalled(key, x, o.lastProgress)
+	}
+}
+
+func (o *fallbackObservation) retireStalled(key string, x *fallbackExchange, progress time.Time) {
+	time.Sleep(o.group.effectiveCloseSampleDelay())
+	o.mux.Lock()
+	o.cleanupPending = false
+	quiet := len(o.writes) == 0 && o.lastProgress == progress
+	retire := !o.closed && quiet && o.pending[key] == x && x.stalled && !o.routeOnlyLocked(x, time.Now()) && o.group.alternateFor(o.proxy, x.host, !o.strongTimeout)
+	if retire {
+		o.closed = true
+		o.stopTimerLocked()
+	}
+	o.mux.Unlock()
+	if retire {
+		_ = o.closeTransport()
+	}
+}
+
+func (o *fallbackObservation) endWrite(w *fallbackWrite, sent bool, err error) {
+	if w == nil {
+		return
+	}
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	delete(o.writes, w)
+	if o.closed {
+		return
+	}
+	if err != nil {
+		if o.pending[w.key] == w.exchange {
+			delete(o.pending, w.key)
+		}
+		if !isIgnoredFallbackError(err) {
+			o.group.reportSuspect(o.proxy, w.host, isStrongFallbackError(err))
+		}
+	}
+	if sent {
+		now := time.Now()
+		if x := o.pending[w.key]; o.strongTimeout || x == nil || !x.stalled {
+			o.lastProgress = now
+		}
+		o.idleObserved = false
+		o.idleFailed = false
+		if x := w.exchange; x != nil && o.pending[w.key] == x && !w.answered && o.strongTimeout {
+			x.repeatedWrite = x.repeatedWrite || !x.lastWrite.IsZero()
+			x.lastWrite = now
+			if !x.stalled {
+				x.advance(now.Add(o.stallTimeout))
+				o.armLocked(x.due)
+			}
+		}
+	}
+	if err == nil && len(o.pending) == 0 && o.responded && !o.receiveEnded && !o.idleObserved && o.idleDue.IsZero() {
+		o.idleDue = time.Now().Add(o.stallTimeout)
+		o.armLocked(o.idleDue)
+	}
+}
+
+func (o *fallbackObservation) stopTimerLocked() {
+	if o.timer != nil {
+		o.timer.Stop()
+		o.timer = nil
+	}
+}
+
+func (o *fallbackObservation) markSuccess(key string) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	host := o.host
+	if key != "" {
+		key = o.replyKey(key)
+		host = o.packetDestination(key)
+	}
+	x := o.pending[key]
+	if x != nil {
+		host = x.host
+		delete(o.pending, key)
+	}
+	for w := range o.writes {
+		if w.key == key {
+			w.answered = true
+		}
+	}
+	now := time.Now()
+	if o.strongTimeout && o.responded && x == nil && (o.idleObserved || (!o.idleDue.IsZero() && !now.Before(o.idleDue))) {
+		o.replyUntil = now.Add(o.stallTimeout)
+	}
+	o.responded, o.lastProgress = true, now
+	o.idleObserved = false
+	o.idleFailed = false
+	if x != nil || ((!o.isolatedUDP || host == o.host) && now.Sub(o.lastSuccess) >= o.stallTimeout) {
+		o.group.recordProxySuccess(o.proxy, host)
+		o.lastSuccess = now
+	}
+	if len(o.pending) == 0 && !o.receiveEnded {
+		o.idleDue = now.Add(o.stallTimeout)
+		o.armLocked(o.idleDue)
+	}
+}
+
+func (o *fallbackObservation) markError(err error) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed || isIgnoredFallbackError(err) {
+		return
+	}
+	eof := errors.Is(err, io.EOF)
+	if eof {
+		o.receiveEnded = true
+	}
+	pendingEOF := eof && o.strongTimeout && len(o.pending) > 0
+	if !o.responded || !eof || pendingEOF {
+		strong := isStrongFallbackError(err)
+		o.group.reportEvidence(o.proxy, o.host, strong, strong || pendingEOF)
+	}
+	o.idleDue = time.Time{}
+	for key := range o.pending {
+		delete(o.pending, key)
+	}
+	if len(o.writes) == 0 {
+		o.stopTimerLocked()
+	}
+}
+
+func (o *fallbackObservation) markPacketReadError(err error) {
+	var netErr net.Error
+	if !errors.As(err, &netErr) || !netErr.Timeout() {
+		o.markError(err)
+		return
+	}
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	for _, x := range o.pending {
+		if !x.stalled {
+			x.stalled, x.awaiting = true, false
+			o.group.reportEvidence(o.proxy, x.host, false, true)
+		}
+	}
+}
+
+func (o *fallbackObservation) close() {
+	o.mux.Lock()
+	o.closed = true
+	o.stopTimerLocked()
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) sampleStall() (time.Time, bool) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.idleObserved {
+		o.idleFailed = true
+	}
+	return o.lastProgress, o.stalledLocked()
+}
+
+func (o *fallbackObservation) stalledLocked() bool {
+	if o.closed {
+		return false
+	}
+	for _, x := range o.pending {
+		if x.stalled && (o.strongTimeout || len(o.writes) == 0) {
+			return true
+		}
+	}
+	return o.idleFailed && len(o.writes) == 0
+}
+
+func (o *fallbackObservation) claimStall(progress time.Time) bool {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.lastProgress != progress || !o.stalledLocked() {
+		return false
+	}
+	o.closed = true
+	o.stopTimerLocked()
+	return true
+}
+
+func (o *fallbackObservation) fallbackState() *fallbackObservation {
+	return o
+}
+
+type fallbackObserverConn struct {
+	C.Conn
+	*fallbackObservation
+}
+
+func (c *fallbackObserverConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n > 0 {
+		c.markSuccess("")
+	}
+	if err != nil {
+		c.markError(err)
+	}
+	return n, err
+}
+
+func (c *fallbackObserverConn) ReadBuffer(buffer *buf.Buffer) error {
+	before := buffer.Len()
+	err := c.Conn.ReadBuffer(buffer)
+	if buffer.Len() > before {
+		c.markSuccess("")
+	}
+	if err != nil {
+		c.markError(err)
+	}
+	return err
+}
+
+func (c *fallbackObserverConn) Write(b []byte) (int, error) {
+	if len(b) == 0 && !N.NeedHandshake(c.Conn) {
+		return c.Conn.Write(b)
+	}
+	w := c.beginWrite("", len(b) > 0)
+	n, err := c.Conn.Write(b)
+	c.endWrite(w, n > 0, err)
+	return n, err
+}
+
+func (c *fallbackObserverConn) WriteBuffer(buffer *buf.Buffer) error {
+	size := buffer.Len()
+	if size == 0 && !N.NeedHandshake(c.Conn) {
+		return c.Conn.WriteBuffer(buffer)
+	}
+	w := c.beginWrite("", size > 0)
+	err := c.Conn.WriteBuffer(buffer)
+	c.endWrite(w, err == nil && size > 0, err)
+	return err
+}
+
+func (c *fallbackObserverConn) Close() error {
+	c.fallbackObservation.close()
+	return c.Conn.Close()
+}
+
+func (c *fallbackObserverConn) ReaderReplaceable() bool {
+	return false
+}
+
+func (c *fallbackObserverConn) WriterReplaceable() bool {
+	return false
+}
+
+func (c *fallbackObserverConn) Upstream() any {
+	return c.Conn
+}
+
+type fallbackObserverPacketConn struct {
+	C.PacketConn
+	*fallbackObservation
+}
+
+func (c *fallbackObserverPacketConn) OnFallbackClose(retire func()) bool {
+	isolated := c.PacketConn.OnFallbackClose(retire)
+	c.mux.Lock()
+	c.isolatedUDP = isolated
+	c.mux.Unlock()
+	return isolated
+}
+
+func (c *fallbackObserverPacketConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	n, addr, err := c.PacketConn.ReadFrom(b)
+	if n > 0 {
+		c.markSuccess(fallbackPacketKey(addr))
+	}
+	if err != nil {
+		c.markPacketReadError(err)
+	}
+	return n, addr, err
+}
+
+func (c *fallbackObserverPacketConn) WaitReadFrom() ([]byte, func(), net.Addr, error) {
+	data, put, addr, err := c.PacketConn.WaitReadFrom()
+	if len(data) > 0 {
+		c.markSuccess(fallbackPacketKey(addr))
+	}
+	if err != nil {
+		c.markPacketReadError(err)
+	}
+	return data, put, addr, err
+}
+
+func (c *fallbackObserverPacketConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	if len(b) == 0 {
+		return c.PacketConn.WriteTo(b, addr)
+	}
+	w := c.beginWrite(fallbackPacketKey(addr), true)
+	n, err := c.PacketConn.WriteTo(b, addr)
+	c.endWrite(w, n > 0, err)
+	return n, err
+}
+
+func (c *fallbackObserverPacketConn) ResolveUDP(ctx context.Context, metadata *C.Metadata) error {
+	host := metadataHostKey(metadata)
+	err := c.PacketConn.ResolveUDP(ctx, metadata)
+	if err == nil {
+		c.rememberAddress(metadata, host)
+	}
+	return err
+}
+
+func (c *fallbackObserverPacketConn) Close() error {
+	c.fallbackObservation.close()
+	return c.PacketConn.Close()
+}
+
+func (c *fallbackObserverPacketConn) ReaderReplaceable() bool {
+	return false
+}
+
+func (c *fallbackObserverPacketConn) WriterReplaceable() bool {
+	return false
+}
+
+func (c *fallbackObserverPacketConn) Upstream() any {
+	return c.PacketConn
+}
+
+func fallbackPacketKey(addr net.Addr) string {
+	if addr == nil {
+		return "_unknown_"
+	}
+	return strings.ToLower(addr.String())
+}
+
+func (o *fallbackObservation) rememberAddress(metadata *C.Metadata, host string) {
+	if metadata == nil || !metadata.DstIP.IsValid() || host == "" {
+		return
+	}
+	key := metadata.AddrPort().String()
+	o.mux.Lock()
+	if old, exists := o.addresses[key]; !exists || old == host {
+		o.addresses[key] = host
+	} else {
+		o.addresses[key] = ""
+	}
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) packetDestination(key string) string {
+	if alias := o.addresses[key]; alias != "" {
+		if _, port, err := net.SplitHostPort(key); err == nil {
+			return net.JoinHostPort(alias, port)
+		}
+	}
+	return key
+}
+
+func (o *fallbackObservation) rememberTarget(key string) {
+	host, port, err := net.SplitHostPort(key)
+	if err != nil {
+		return
+	}
+	if _, err := netip.ParseAddr(host); err == nil {
+		o.numericTargets[key] = true
+	} else if previous, ok := o.domainByPort[port]; !ok || previous == key {
+		o.domainByPort[port] = key
+	} else {
+		o.domainByPort[port] = ""
+	}
+}
+
+func (o *fallbackObservation) replyKey(key string) string {
+	if o.pending[key] != nil || o.numericTargets[key] {
+		return key
+	}
+	host, port, err := net.SplitHostPort(key)
+	if err != nil {
+		return key
+	}
+	if _, err := netip.ParseAddr(host); err != nil {
+		return key
+	}
+	domain := o.domainByPort[port]
+	if resolved, ok := o.addresses[key]; ok {
+		domain = net.JoinHostPort(resolved, port)
+	}
+	if o.pending[domain] != nil {
+		return domain
+	}
+	return key
+}
+
+func fallbackStateFor(tracker statistic.Tracker, group *Fallback, proxy C.Proxy) *fallbackObservation {
+	for value := any(tracker); value != nil; {
+		if observed, ok := value.(interface{ fallbackState() *fallbackObservation }); ok {
+			state := observed.fallbackState()
+			if state.group == group && state.proxy == proxy {
+				return state
+			}
+		}
+		wrapped, ok := value.(N.WithUpstream)
+		if !ok {
+			break
+		}
+		value = wrapped.Upstream()
+	}
+	return nil
+}
+
+var _ C.Conn = (*fallbackObserverConn)(nil)
+var _ C.PacketConn = (*fallbackObserverPacketConn)(nil)
+
+func isIgnoredFallbackError(err error) bool {
+	return errors.Is(err, context.Canceled) ||
+		errors.Is(err, C.ErrNotSupport) ||
+		errors.Is(err, net.ErrClosed)
+}
+
+func isStrongFallbackError(err error) bool {
+	if errors.Is(err, context.DeadlineExceeded) {
+		return true
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return true
+	}
+	msg := strings.ToLower(err.Error())
+	return strings.Contains(msg, "connection reset") ||
+		strings.Contains(msg, "broken pipe") ||
+		strings.Contains(msg, "connection refused") ||
+		strings.Contains(msg, "i/o timeout")
+}
+
+func metadataHostKey(metadata *C.Metadata) string {
+	if metadata == nil {
+		return ""
+	}
+	if metadata.Host != "" {
+		return strings.ToLower(metadata.Host)
+	}
+	if metadata.DstIP.IsValid() {
+		return metadata.DstIP.String()
+	}
+	return metadata.RemoteAddress()
+}
+
+func udpDestinationKey(metadata *C.Metadata) string {
+	if host := metadataHostKey(metadata); host != "" {
+		return net.JoinHostPort(host, strconv.Itoa(int(metadata.DstPort)))
+	}
+	return ""
+}
+
+func fallbackRouteKey(metadata *C.Metadata) string {
+	if metadata != nil && metadata.NetWork == C.UDP {
+		return udpDestinationKey(metadata)
+	}
+	return metadataHostKey(metadata)
+}
+
+func destinationHost(key string) string {
+	if host, _, err := net.SplitHostPort(key); err == nil {
+		return host
+	}
+	return key
+}
