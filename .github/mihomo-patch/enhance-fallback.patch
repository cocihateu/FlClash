+const (
+	fallbackMinStaggerDelay    = 1500 * time.Millisecond
+	fallbackMaxStaggerDelay    = 3000 * time.Millisecond
+	fallbackMaxDialAttempts    = 3
+	fallbackMinStallThreshold  = 4 * time.Second
+	fallbackMaxStallThreshold  = 10 * time.Second
+	fallbackProbeTimeout       = 3 * time.Second
+	fallbackHostWindow         = 60 * time.Second
