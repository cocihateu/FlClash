+func (f *Fallback) wrapObservedPacketConn(c C.PacketConn, proxy C.Proxy, metadata *C.Metadata, target string) C.PacketConn {
+	c.AppendToChains(f)
+	if isSkippableAdapter(proxy.Type()) {
+		return c
+	}
+	o := f.observe(proxy, target, false, func() error { _ = c.SetWriteDeadline(time.Now()); return c.Close() })
+	o.addresses = make(map[string]string)
+	o.domainByPort = make(map[string]string)
+	o.numericTargets = make(map[string]bool)
+	o.rememberAddress(metadata, destinationHost(target))
+	return &fallbackObserverPacketConn{PacketConn: c, fallbackObservation: o}
