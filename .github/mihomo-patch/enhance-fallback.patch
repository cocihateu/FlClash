+func (f *Fallback) demoteProxy(proxy C.Proxy, reason string) {
+	f.demoteProxyIfOwner(proxy, nil, reason)
+}
+
+func (f *Fallback) demoteProxyIfOwner(proxy C.Proxy, owner *proxyFailState, reason string) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	name := proxy.Name()
+
+	f.stateMux.Lock()
+	if owner != nil && f.proxyStates[name] != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st := f.proxyStateLocked(proxy)
+	if st == nil || (owner != nil && st != owner) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	// Avoid escalating backoff multiple times within an already-active cooldown.
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	cooldown := f.effectiveBaseCooldown() << uint(st.backoffLevel)
+	if cooldown > fallbackMaxCooldown {
+		cooldown = fallbackMaxCooldown
+	}
+	if st.backoffLevel < 4 {
+		st.backoffLevel++
+	}
+	st.cooldownUntil = now.Add(cooldown)
+	st.suspectHosts = nil
+	st.stopProbeTimerLocked()
+	if f.selected == name {
+		f.selected = ""
+	}
+	f.stateMux.Unlock()
+
+	log.Warnln("Fallback[%s]: proxy %s demoted for %v (%s)", f.Name(), name, cooldown, reason)
+	go f.closeStalledConnectionsForProxy(proxy, st)
+}
+
+func (f *Fallback) closeStalledConnectionsForProxy(proxy C.Proxy, owner *proxyFailState) {
+	groupName := f.Name()
+	type trafficSample struct {
+		observer *fallbackObserverConn
+		upload   int64
+		download int64
+	}
+	samples := make(map[statistic.Tracker]trafficSample)
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		observer, ok := N.FindUpstream[*fallbackObserverConn](c, func(observer *fallbackObserverConn) bool {
+			return observer.group == f && observer.proxy == proxy && observer.stalled.Load() && !observer.closed.Load()
+		})
+		if !ok {
+			return true
+		}
+		info := c.Info()
+		if info == nil {
+			return true
+		}
+		samples[c] = trafficSample{
+			observer: observer,
+			upload:   info.UploadTotal.Load(),
+			download: info.DownloadTotal.Load(),
+		}
+		return true
+	})
+
+	if len(samples) == 0 {
+		return
+	}
+
+	time.Sleep(f.effectiveCloseSampleDelay())
+
+	closedCount := 0
+	for c, sample := range samples {
+		info := c.Info()
+		if info == nil || sample.observer.closed.Load() || !sample.observer.stalled.Load() {
+			continue
+		}
+		f.stateMux.Lock()
+		current := f.proxyStates[proxy.Name()] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if current && info.UploadTotal.Load() == sample.upload && info.DownloadTotal.Load() == sample.download {
+			_ = c.Close()
+			closedCount++
+		}
+	}
+	if closedCount > 0 {
+		log.Warnln("Fallback[%s]: closed %d stalled connections on demoted proxy %s", groupName, closedCount, proxy.Name())
+	}
+}
