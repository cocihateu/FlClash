+func (f *Fallback) proxyStateLocked(proxy C.Proxy) *proxyFailState {
+	for _, current := range f.GetProxies(false) {
+		if current != proxy {
+			continue
+		}
+		if f.proxyStates == nil {
+			f.proxyStates = make(map[string]*proxyFailState)
+		}
+		name := proxy.Name()
+		st := f.proxyStates[name]
+		if st == nil || st.proxy != proxy {
+			if st != nil {
+				st.stopProbeTimerLocked()
+			}
+			st = &proxyFailState{proxy: proxy}
+			f.proxyStates[name] = st
+		}
+		return st
+	}
+	return nil
+}
