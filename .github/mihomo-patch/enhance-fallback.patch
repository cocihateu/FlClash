+func (f *Fallback) isDemotedLocked(proxy C.Proxy, now time.Time) bool {
+	st, ok := f.proxyStates[proxy.Name()]
+	if !ok || st.proxy != proxy {
+		return false
+	}
+	return now.Before(st.cooldownUntil)
+}
