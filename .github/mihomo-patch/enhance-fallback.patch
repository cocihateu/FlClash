+	f.stateMux.Lock()
+	if owner != nil && f.proxyStates[name] != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st := f.proxyStateLocked(proxy)
+	if st == nil || (owner != nil && st != owner) {
+		f.stateMux.Unlock()
+		return
+	}
