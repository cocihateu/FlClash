+func (f *Fallback) affectedLocked(proxy C.Proxy, host string, now time.Time) bool {
+	st := f.proxyStates[proxy.Name()]
+	if st == nil || st.proxy != proxy {
+		return false
+	}
+	at, found := st.affectedHosts[host]
+	return found && now.Sub(at) < fallbackHostWindow
+}
+
+func (f *Fallback) alternateFor(proxy C.Proxy, host string, udp bool) bool {
+	proxies := f.GetProxies(false)
+	now := time.Now()
+	for _, p := range proxies {
+		if p == proxy || isSkippableAdapter(p.Type()) || (udp && !p.SupportUDP()) || !p.AliveForTestUrl(f.testUrl) {
+			continue
+		}
+		f.stateMux.Lock()
+		ok := f.affectedLocked(proxy, host, now) && !f.isDemotedLocked(p, now) && !f.affectedLocked(p, host, now)
+		f.stateMux.Unlock()
+		if ok {
+			return true
+		}
+	}
+	return false
+}
