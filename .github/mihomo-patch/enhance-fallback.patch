+type fallbackExchange struct {
+	host     string
+	due      time.Time
+	stalled  bool
+	awaiting bool
+}
+
+type fallbackWrite struct {
+	key      string
+	host     string
+	started  time.Time
+	answered bool
+}
+
+type fallbackObservation struct {
+	group          *Fallback
+	proxy          C.Proxy
+	host           string
+	stallTimeout   time.Duration
+	strongTimeout  bool
+	closeTransport func() error
+	mux            sync.Mutex
+	timer          *time.Timer
+	pending        map[string]*fallbackExchange
+	addresses      map[string]string
+	writes         map[*fallbackWrite]struct{}
+	idleDue        time.Time
+	armedFor       time.Time
+	lastProgress   time.Time
+	lastSuccess    time.Time
+	cleanupPending bool
+	idleObserved   bool
+	idleFailed     bool
+	responded      bool
+	closed         bool
+	receiveEnded   bool
+}
+
+func (o *fallbackObservation) beginWrite(key string) *fallbackWrite {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return nil
+	}
+	host := o.host
+	if key != "" {
+		host = o.packetHost(key)
+	}
+	now := time.Now()
+	w := &fallbackWrite{key: key, host: host, started: now}
+	o.writes[w] = struct{}{}
+	if !o.receiveEnded {
+		if x := o.pending[key]; x == nil {
+			o.pending[key] = &fallbackExchange{host: host, due: now.Add(o.stallTimeout), awaiting: true}
+		} else if !x.awaiting {
+			x.awaiting, x.due = true, now.Add(o.stallTimeout)
+			if o.strongTimeout {
+				x.stalled = false
+			}
+		}
+	}
+	o.idleDue = time.Time{}
+	o.idleObserved = false
+	o.idleFailed = false
+	o.armLocked(w.started.Add(o.stallTimeout))
+	return w
+}
+
+func (o *fallbackObservation) armLocked(due time.Time) {
+	if o.closed || due.IsZero() || (o.timer != nil && !due.Before(o.armedFor)) {
+		return
+	}
+	o.stopTimerLocked()
+	var t *time.Timer
+	t = time.AfterFunc(time.Until(due), func() {
+		o.mux.Lock()
+		o.expireLocked(t)
+	})
+	o.timer, o.armedFor = t, due
+}
+
+func (o *fallbackObservation) expireLocked(t *time.Timer) {
+	if o.closed || o.timer != t {
+		o.mux.Unlock()
+		return
+	}
+	o.timer = nil
+	now := time.Now()
+	for w := range o.writes {
+		due := w.started.Add(o.stallTimeout)
+		if !now.Before(due) {
+			o.group.reportEvidence(o.proxy, w.host, o.strongTimeout, true)
+			o.closed = true
+			o.stopTimerLocked()
+			o.mux.Unlock()
+			_ = o.closeTransport()
+			return
+		}
+		o.armLocked(due)
+	}
+	for key, x := range o.pending {
+		if !now.Before(x.due) {
+			// A fresh write has its own deadline; let actual upload progress settle first.
+			for w := range o.writes {
+				if w.key == key && !w.answered {
+					x.due = w.started.Add(o.stallTimeout)
+					break
+				}
+			}
+			if !now.Before(x.due) {
+				x.stalled, x.awaiting = true, false
+				o.group.reportEvidence(o.proxy, x.host, o.strongTimeout, true)
+				if !o.cleanupPending && o.group.alternateFor(o.proxy, x.host, !o.strongTimeout) {
+					o.cleanupPending = true
+					go o.retireStalled(key, x, o.lastProgress)
+				}
+				x.due = now.Add(o.group.effectiveProbeGap(false))
+			}
+		}
+		o.armLocked(x.due)
+	}
+	if !o.idleDue.IsZero() {
+		if !now.Before(o.idleDue) {
+			o.idleObserved = true
+			o.group.reportEvidence(o.proxy, o.host, false, false)
+			o.idleDue = now.Add(o.group.effectiveProbeGap(false))
+		}
+		o.armLocked(o.idleDue)
+	}
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) retireStalled(key string, x *fallbackExchange, progress time.Time) {
+	time.Sleep(o.group.effectiveCloseSampleDelay())
+	o.mux.Lock()
+	o.cleanupPending = false
+	retire := !o.closed && len(o.writes) == 0 && o.pending[key] == x && x.stalled && o.lastProgress == progress && o.group.alternateFor(o.proxy, x.host, !o.strongTimeout)
+	if retire {
+		o.closed = true
+		o.stopTimerLocked()
+	}
+	o.mux.Unlock()
+	if retire {
+		_ = o.closeTransport()
+	}
+}
+
+func (o *fallbackObservation) endWrite(w *fallbackWrite, sent bool, err error) {
+	if w == nil {
+		return
+	}
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	delete(o.writes, w)
+	if o.closed {
+		return
+	}
+	if err != nil {
+		delete(o.pending, w.key)
+		if !isIgnoredFallbackError(err) {
+			o.group.reportSuspect(o.proxy, w.host, isStrongFallbackError(err))
+		}
+	}
+	if sent {
+		now := time.Now()
+		if o.strongTimeout || o.pending[w.key] == nil || !o.pending[w.key].stalled {
+			o.lastProgress = now
+		}
+		o.idleObserved = false
+		o.idleFailed = false
+		if x := o.pending[w.key]; x != nil && !w.answered && o.strongTimeout {
+			x.due, x.stalled = now.Add(o.stallTimeout), false
+		}
+	}
+	if err == nil && len(o.pending) == 0 && o.responded && !o.receiveEnded && o.idleDue.IsZero() {
+		o.idleDue = time.Now().Add(o.stallTimeout)
+		o.armLocked(o.idleDue)
+	}
+}
+
+func (o *fallbackObservation) stopTimerLocked() {
+	if o.timer != nil {
+		o.timer.Stop()
+		o.timer = nil
+	}
+}
+
+func (o *fallbackObservation) markSuccess(key string) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	host := o.host
+	if key != "" {
+		host = o.packetHost(key)
+	}
+	x := o.pending[key]
+	if x != nil {
+		host = x.host
+		delete(o.pending, key)
+	}
+	for w := range o.writes {
+		if w.key == key {
+			w.answered = true
+		}
+	}
+	now := time.Now()
+	o.responded, o.lastProgress = true, now
+	o.idleObserved = false
+	o.idleFailed = false
+	if x != nil || now.Sub(o.lastSuccess) >= o.stallTimeout {
+		o.group.recordProxySuccess(o.proxy, host)
+		o.lastSuccess = now
+	}
+	if len(o.pending) == 0 && !o.receiveEnded {
+		o.idleDue = now.Add(o.stallTimeout)
+		o.armLocked(o.idleDue)
+	}
+}
+
+func (o *fallbackObservation) markError(err error) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed || isIgnoredFallbackError(err) {
+		return
+	}
+	if errors.Is(err, io.EOF) {
+		o.receiveEnded = true
+	}
+	if !o.responded || !errors.Is(err, io.EOF) {
+		strong := isStrongFallbackError(err)
+		o.group.reportEvidence(o.proxy, o.host, strong, strong || (o.strongTimeout && len(o.pending) > 0 && errors.Is(err, io.EOF)))
+	}
+	o.idleDue = time.Time{}
+	for key := range o.pending {
+		delete(o.pending, key)
+	}
+	if len(o.writes) == 0 {
+		o.stopTimerLocked()
+	}
+}
+
+func (o *fallbackObservation) markPacketReadError(err error) {
+	var netErr net.Error
+	if !errors.As(err, &netErr) || !netErr.Timeout() {
+		o.markError(err)
+		return
+	}
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.closed {
+		return
+	}
+	for _, x := range o.pending {
+		if !x.stalled {
+			x.stalled, x.awaiting = true, false
+			o.group.reportEvidence(o.proxy, x.host, false, true)
+		}
+	}
+}
+
+func (o *fallbackObservation) close() {
+	o.mux.Lock()
+	o.closed = true
+	o.stopTimerLocked()
+	o.mux.Unlock()
+}
+
+func (o *fallbackObservation) sampleStall(failedIdle bool) (time.Time, bool) {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if failedIdle && o.idleObserved {
+		o.idleFailed = true
+	}
+	return o.lastProgress, o.stalledLocked()
+}
+
+func (o *fallbackObservation) stalledLocked() bool {
+	if o.closed || len(o.writes) != 0 {
+		return false
+	}
+	for _, x := range o.pending {
+		if x.stalled {
+			return true
+		}
+	}
+	return o.idleFailed
+}
+
+func (o *fallbackObservation) claimStall(progress time.Time) bool {
+	o.mux.Lock()
+	defer o.mux.Unlock()
+	if o.lastProgress != progress || !o.stalledLocked() {
+		return false
+	}
+	o.closed = true
+	o.stopTimerLocked()
+	return true
+}
+
+func (o *fallbackObservation) fallbackState() *fallbackObservation {
+	return o
+}
