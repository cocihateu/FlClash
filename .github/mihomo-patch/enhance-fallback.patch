+func (f *Fallback) probeProxy(ctx context.Context, proxy C.Proxy) error {
+	expectedStatus, _ := utils.NewUnsignedRanges[uint16](f.expectedStatus)
+	_, err := proxy.URLTest(ctx, f.testUrl, expectedStatus)
+	if err == nil && !proxy.AliveForTestUrl(f.testUrl) {
+		err = errors.New("health response status outside expected range")
+	}
