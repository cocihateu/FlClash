+func (f *Fallback) proxyStateLocked(proxy C.Proxy) *proxyFailState {
+	for _, current := range f.GetProxies(false) {
+		if current != proxy {
+			continue
+		}
+		if f.proxyStates == nil {
+			f.proxyStates = make(map[string]*proxyFailState)
+		}
+		name := proxy.Name()
+		st := f.proxyStates[name]
+		if st == nil || st.proxy != proxy {
+			if st != nil {
+				st.stopProbeTimerLocked()
+			}
+			st = &proxyFailState{proxy: proxy}
+			f.proxyStates[name] = st
+		}
+		return st
+	}
+	return nil
+}
+
+func (f *Fallback) isDemotedLocked(proxy C.Proxy, now time.Time) bool {
+	st, ok := f.proxyStates[proxy.Name()]
+	if !ok || st.proxy != proxy {
+		return false
+	}
+	return now.Before(st.cooldownUntil)
+}
+
+func (f *Fallback) demoteProxy(proxy C.Proxy, reason string) {
+	f.demoteProxyIfOwner(proxy, nil, reason)
+}
+
+func (f *Fallback) demoteProxyIfOwner(proxy C.Proxy, owner *proxyFailState, reason string) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	name := proxy.Name()
+
+	f.stateMux.Lock()
+	if owner != nil && f.proxyStates[name] != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st := f.proxyStateLocked(proxy)
+	if st == nil || (owner != nil && st != owner) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	// An active cooldown retains its deadline.
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	cooldown := f.effectiveBaseCooldown() << uint(st.backoffLevel)
+	if cooldown > fallbackMaxCooldown {
+		cooldown = fallbackMaxCooldown
+	}
+	if st.backoffLevel < 4 {
+		st.backoffLevel++
+	}
+	st.cooldownUntil = now.Add(cooldown)
+	st.suspectHosts = nil
+	st.stopProbeTimerLocked()
+	if f.selected == name {
+		f.selected = ""
+	}
+	f.stateMux.Unlock()
+
+	log.Warnln("Fallback[%s]: proxy %s demoted for %v (%s)", f.Name(), name, cooldown, reason)
+	go f.closeStalledConnectionsForProxy(proxy, st)
+}
+
+func (f *Fallback) closeStalledConnectionsForProxy(proxy C.Proxy, owner *proxyFailState) {
+	type trafficSample struct {
+		observer *fallbackObservation
+		download int64
+	}
+	samples := make(map[statistic.Tracker]trafficSample)
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		observer := fallbackStateFor(c, f, proxy)
+		if observer == nil || observer.isClosed() {
+			return true
+		}
+		if info := c.Info(); info != nil {
+			samples[c] = trafficSample{observer: observer, download: info.DownloadTotal.Load()}
+		}
+		return true
+	})
+	if len(samples) == 0 {
+		return
+	}
+	time.Sleep(f.effectiveCloseSampleDelay())
+	closedCount := 0
+	for c, sample := range samples {
+		info := c.Info()
+		if info == nil || sample.observer.isClosed() {
+			continue
+		}
+		f.stateMux.Lock()
+		current := f.proxyStates[proxy.Name()] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if current && info.DownloadTotal.Load() == sample.download {
+			_ = c.Close()
+			closedCount++
+		}
+	}
+	if closedCount > 0 {
+		log.Warnln("Fallback[%s]: closed %d stalled connections on demoted proxy %s", f.Name(), closedCount, proxy.Name())
+	}
+}
