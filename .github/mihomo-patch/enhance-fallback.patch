+func (f *Fallback) findProbePeer(excludeName string) C.Proxy {
+	proxies := f.GetProxies(false)
+	now := time.Now()
+
+	f.stateMux.Lock()
+	defer f.stateMux.Unlock()
+
+	var fallbackPeer C.Proxy
+	for _, p := range proxies {
+		if p.Name() == excludeName || isSkippableAdapter(p.Type()) {
+			continue
+		}
+		if !f.isDemotedLocked(p, now) {
+			if p.AliveForTestUrl(f.testUrl) {
+				return p
+			}
+			if fallbackPeer == nil {
+				fallbackPeer = p
+			}
+		} else if fallbackPeer == nil {
+			fallbackPeer = p
+		}
+	}
+	return fallbackPeer
+}
+
+func (f *Fallback) probePair(ctx context.Context, self, peer C.Proxy) (errSelf, errPeer error) {
+	expectedStatus, _ := utils.NewUnsignedRanges[uint16](f.expectedStatus)
+	if peer == nil {
+		_, errSelf = self.URLTest(ctx, f.testUrl, expectedStatus)
+		return errSelf, errors.New("no peer proxy available")
+	}
+
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		_, errSelf = self.URLTest(ctx, f.testUrl, expectedStatus)
+	}()
+	go func() {
+		defer wg.Done()
+		_, errPeer = peer.URLTest(ctx, f.testUrl, expectedStatus)
+	}()
+	wg.Wait()
+	return errSelf, errPeer
+}
+
+func (f *Fallback) reportSuspect(proxy C.Proxy, host string, strong bool) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	if host == "" {
+		host = "_unknown_"
+	}
+
+	shouldDemoteMultiHost := false
+	shouldProbe := false
+
+	f.stateMux.Lock()
+	st := f.proxyStateLocked(proxy)
+	if st == nil || now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	// Only strong signals (watchdog stall / reset / timeout) count toward multi-host demotion.
+	// Weak signals (e.g. io.EOF from a dead target site) only trigger at most a comparative probe.
+	if strong {
+		if st.suspectHosts == nil {
+			st.suspectHosts = make(map[string]time.Time)
+		}
+		for h, ts := range st.suspectHosts {
+			if now.Sub(ts) > fallbackHostWindow {
+				delete(st.suspectHosts, h)
+			}
+		}
+		st.suspectHosts[host] = now
+
+		if len(st.suspectHosts) >= fallbackHostThreshold {
+			shouldDemoteMultiHost = true
+		}
+	}
+
+	if !shouldDemoteMultiHost {
+		minGap := f.effectiveProbeGap(strong)
+		switch {
+		case st.probing:
+			if strong {
+				st.pendingProbe = true
+			}
+		case st.lastProbe.IsZero() || now.Sub(st.lastProbe) >= minGap:
+			st.probing = true
+			st.lastProbe = now
+			st.stopProbeTimerLocked()
+			shouldProbe = true
+		case strong && st.probeTimer == nil:
+			wait := minGap - now.Sub(st.lastProbe)
+			f.scheduleProbeLocked(st, proxy, wait)
+		}
+	}
+	owner := st
+	f.stateMux.Unlock()
+
+	if shouldDemoteMultiHost {
+		f.demoteProxyIfOwner(proxy, owner, "multiple distinct hosts stalled/failed")
+		return
+	}
+
+	if shouldProbe {
+		f.startProbe(proxy, owner)
+	}
+}
+
+func (f *Fallback) scheduleProbeLocked(st *proxyFailState, proxy C.Proxy, wait time.Duration) {
+	st.probeGen++
+	gen := st.probeGen
+	owner := st
+	p := proxy
+	st.probeTimer = time.AfterFunc(wait, func() {
+		f.runDeferredProbe(p, owner, gen)
+	})
+}
+
+func (f *Fallback) runDeferredProbe(proxy C.Proxy, owner *proxyFailState, gen uint64) {
+	if proxy == nil {
+		return
+	}
+	name := proxy.Name()
+	now := time.Now()
+
+	f.stateMux.Lock()
+	st, ok := f.proxyStates[name]
+	if !ok || st != owner || st.probeGen != gen || f.proxyStateLocked(proxy) != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st.probeTimer = nil
+	if now.Before(st.cooldownUntil) {
+		st.pendingProbe = false
+		f.stateMux.Unlock()
+		return
+	}
+	if st.probing {
+		st.pendingProbe = true
+		f.stateMux.Unlock()
+		return
+	}
+	st.probing = true
+	st.pendingProbe = false
+	st.lastProbe = now
+	f.stateMux.Unlock()
+
+	f.startProbe(proxy, owner)
+}
+
+func (f *Fallback) startProbe(proxy C.Proxy, owner *proxyFailState) {
+	name := proxy.Name()
+	peer := f.findProbePeer(name)
+	go func() {
+		f.stateMux.Lock()
+		current := f.proxyStates[name] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if !current {
+			return
+		}
+		defer func() {
+			f.stateMux.Lock()
+			if st, ok := f.proxyStates[name]; ok && st == owner && f.proxyStateLocked(proxy) == owner {
+				st.probing = false
+				if st.pendingProbe && st.probeTimer == nil && !time.Now().Before(st.cooldownUntil) {
+					st.pendingProbe = false
+					f.scheduleProbeLocked(st, proxy, f.effectiveProbeGap(true))
+				}
+			}
+			f.stateMux.Unlock()
+		}()
+
+		ctx, cancel := context.WithTimeout(context.Background(), f.probeTimeoutForProxy(proxy))
+		defer cancel()
+
+		errSelf, errPeer := f.probePair(ctx, proxy, peer)
+		// Comparative health results apply to the current proxy instance and state owner.
+		if errSelf != nil && errPeer == nil {
+			f.demoteProxyIfOwner(proxy, owner, "comparative URLTest failed while peer ok: "+errSelf.Error())
+		}
+	}()
+}
+
+func (f *Fallback) recordProxySuccess(proxy C.Proxy) {
+	if proxy == nil {
+		return
+	}
+
+	for _, current := range f.GetProxies(false) {
+		if current != proxy {
+			continue
+		}
+		now := time.Now()
+		f.stateMux.Lock()
+		if st := f.proxyStates[proxy.Name()]; st != nil && st.proxy == proxy {
+			if now.Before(st.cooldownUntil) {
+				f.stateMux.Unlock()
+				return
+			}
+			st.suspectHosts = nil
+			if st.backoffLevel > 0 && !st.cooldownUntil.IsZero() && now.Sub(st.cooldownUntil) >= f.effectiveRecoveryWindow() {
+				st.backoffLevel--
+				st.cooldownUntil = now
+			}
+		}
+		f.stateMux.Unlock()
+		f.onDialSuccess()
+		return
+	}
+}
+
+func (f *Fallback) wrapObservedConn(c C.Conn, proxy C.Proxy, host string) C.Conn {
+	c.AppendToChains(f)
+	if N.NeedHandshake(c) {
+		p := proxy
+		c = callback.NewFirstWriteCallBackConn(c, func(wErr error) {
+			if wErr == nil {
+				// First-response observation owns suspect-host recovery.
+				f.onDialSuccess()
+			} else if !isIgnoredFallbackError(wErr) {
+				f.reportSuspect(p, host, isStrongFallbackError(wErr))
+			}
+		})
