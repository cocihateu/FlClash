+func TestFallbackPairedProbeDemotesOnlyWhenPeerHealthy(t *testing.T) {
+	// Case 1: primary fails probe, backup passes -> demote primary
+	primary := newMockProxy("cf-primary")
+	backup := newMockProxy("backup-1")
+	probeErr := errors.New("probe timeout")
+	primary.urlTestErr.Store(&probeErr)
+
+	fb := newTestFallback(t, primary, backup)
+	c, err := fb.DialContext(context.Background(), &C.Metadata{Host: "example.com"})
+	if err != nil {
+		t.Fatalf("DialContext failed: %v", err)
+	}
+	defer c.Close()
+
+	if _, err := c.Write([]byte("GET / HTTP/1.1\r\n\r\n")); err != nil {
+		t.Fatalf("Write failed: %v", err)
+	}
+
+	deadline := time.Now().Add(500 * time.Millisecond)
+	for time.Now().Before(deadline) {
+		if fb.Now() == "backup-1" {
+			break
+		}
+		time.Sleep(15 * time.Millisecond)
+	}
+	if got := fb.Now(); got != "backup-1" {
+		t.Fatalf("expected fallback to backup-1 when peer ok, got %s", got)
+	}
+
+	// Case 2: BOTH primary and backup fail probe (local outage) -> do NOT demote
+	p2 := newMockProxy("cf-primary-2")
+	b2 := newMockProxy("backup-2")
+	p2.urlTestErr.Store(&probeErr)
+	b2.urlTestErr.Store(&probeErr)
+	fb2 := newTestFallback(t, p2, b2)
+
+	fb2.reportSuspect(p2, "example.com", true)
+	time.Sleep(100 * time.Millisecond)
+	if got := fb2.Now(); got != "cf-primary-2" {
+		t.Fatalf("both probes failing (local outage) must NOT demote primary, got %s", got)
+	}
+}
