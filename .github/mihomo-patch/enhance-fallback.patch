+func TestFallbackStaleDeferredProbeIgnored(t *testing.T) {
+	primary := newMockProxy("cf-primary")
+	backup := newMockProxy("backup-1")
+	fb := newTestFallback(t, primary, backup)
+	fb.strongProbeGap = 50 * time.Millisecond
+
+	fb.reportSuspect(primary, "a.com", true)
+	time.Sleep(20 * time.Millisecond)
+	fb.reportSuspect(primary, "b.com", true)
+
+	fb.stateMux.Lock()
+	st := fb.proxyStates["cf-primary"]
+	staleGen := st.probeGen
+	st.stopProbeTimerLocked()
+	fb.stateMux.Unlock()
+
+	before := primary.urlTests.Load()
+	fb.runDeferredProbe(primary, st, staleGen)
+	time.Sleep(30 * time.Millisecond)
+
+	fb.stateMux.Lock()
+	pending := st.pendingProbe
+	fb.stateMux.Unlock()
+	if primary.urlTests.Load() != before || pending {
+		t.Fatalf("stale callback must be no-op: tests %d->%d pending=%v", before, primary.urlTests.Load(), pending)
+	}
+
+	// Replace state via Set(): callback bound to old owner must also be a no-op
+	_ = fb.Set("cf-primary")
+	fb.reportSuspect(primary, "c.com", true)
+	time.Sleep(20 * time.Millisecond)
+	before = primary.urlTests.Load()
+	fb.runDeferredProbe(primary, st, st.probeGen)
+	time.Sleep(30 * time.Millisecond)
+	if primary.urlTests.Load() != before {
+		t.Fatalf("callback bound to replaced state must be no-op")
+	}
+}
