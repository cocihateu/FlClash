+func (f *Fallback) findProbePeer(excludeName string) C.Proxy {
+	proxies := f.GetProxies(false)
+	now := time.Now()
+
+	f.stateMux.Lock()
+	defer f.stateMux.Unlock()
+
+	var fallbackPeer C.Proxy
+	for _, p := range proxies {
+		if p.Name() == excludeName || isSkippableAdapter(p.Type()) {
+			continue
+		}
+		if !f.isDemotedLocked(p, now) {
+			if p.AliveForTestUrl(f.testUrl) {
+				return p
+			}
+			if fallbackPeer == nil {
+				fallbackPeer = p
+			}
+		} else if fallbackPeer == nil {
+			fallbackPeer = p
+		}
+	}
+	return fallbackPeer
+}
