+func (f *Fallback) wrapObservedConn(c C.Conn, proxy C.Proxy, host string) C.Conn {
+	c.AppendToChains(f)
+	if isSkippableAdapter(proxy.Type()) {
+		return c
+	}
+	return &fallbackObserverConn{Conn: c, fallbackObservation: f.observe(proxy, host, true, func() error {
+		_ = c.SetWriteDeadline(time.Now())
+		return c.Close()
+	})}
