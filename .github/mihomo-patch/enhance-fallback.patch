+// MatchGroup scopes the batch to its live provider and the connection member's live owner.
+func (r HealthCheckUpdates) MatchGroup(providers []P.ProxyProvider, member C.Proxy, url string) func(proxy C.Proxy, recovered bool) bool {
+	updates := r.byURL[url]
+	if len(updates) == 0 || r.source.ctx.Err() != nil {
+		return nil
+	}
+	var sourceMembers []C.Proxy
+	var memberPresent bool
+	for _, pd := range providers {
+		p, ok := pd.(interface{ healthChecker() *HealthCheck })
+		if !ok {
+			continue
+		}
+		hc := p.healthChecker()
+		if hc.ctx.Err() != nil {
+			continue
+		}
+		members := pd.Proxies()
+		if hc == r.source {
+			sourceMembers = members
+		}
+		memberPresent = memberPresent || slices.Contains(members, member)
+		if memberPresent && len(sourceMembers) > 0 {
+			return func(proxy C.Proxy, recovered bool) bool {
+				outcome, ok := updates[proxy]
+				return ok && outcome == recovered && slices.Contains(sourceMembers, proxy)
+			}
+		}
+	}
+	return nil
+}
