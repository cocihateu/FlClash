+			break
+		}
+		time.Sleep(15 * time.Millisecond)
+	}
+	if got := fb.Now(); got != "backup-1" {
+		t.Fatalf("3 stalled NeedHandshake hosts should demote primary even though first write succeeded, got %s", got)
+	}
+}
