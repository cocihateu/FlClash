+	f.stateMux.Lock()
+	if owner != nil && f.proxyStates[name] != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st := f.proxyStateLocked(proxy)
+	if st == nil || (owner != nil && st != owner) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	// An active cooldown retains its deadline.
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	cooldown := f.effectiveBaseCooldown() << uint(st.backoffLevel)
+	if cooldown > fallbackMaxCooldown {
+		cooldown = fallbackMaxCooldown
+	}
+	if st.backoffLevel < 4 {
+		st.backoffLevel++
+	}
+	st.cooldownUntil = now.Add(cooldown)
+	st.suspectHosts = nil
+	st.stopProbeTimerLocked()
+	if f.selected == name {
+		f.selected = ""
+	}
+	f.stateMux.Unlock()
+
+	log.Warnln("Fallback[%s]: proxy %s demoted for %v (%s)", f.Name(), name, cooldown, reason)
+	go f.closeStalledConnectionsForProxy(proxy, st, failedIdle)
+}
+
+func (f *Fallback) closeStalledConnectionsForProxy(proxy C.Proxy, owner *proxyFailState, failedIdle bool) {
+	type trafficSample struct {
+		observer *fallbackObservation
+		progress time.Time
+		upload   int64
+		download int64
+	}
+	samples := make(map[statistic.Tracker]trafficSample)
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		observer := fallbackStateFor(c, f, proxy)
+		if observer == nil {
+			return true
+		}
+		progress, stalled := observer.sampleStall(failedIdle)
+		if info := c.Info(); stalled && info != nil {
+			samples[c] = trafficSample{observer: observer, progress: progress, upload: info.UploadTotal.Load(), download: info.DownloadTotal.Load()}
+		}
+		return true
+	})
+	if len(samples) == 0 {
+		return
+	}
+	time.Sleep(f.effectiveCloseSampleDelay())
+	closedCount := 0
+	for c, sample := range samples {
+		info := c.Info()
+		if info == nil {
+			continue
+		}
+		f.stateMux.Lock()
+		current := f.proxyStates[proxy.Name()] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if current && info.UploadTotal.Load() == sample.upload && info.DownloadTotal.Load() == sample.download && sample.observer.claimStall(sample.progress) {
+			if conn, ok := c.(interface{ SetWriteDeadline(time.Time) error }); ok {
+				_ = conn.SetWriteDeadline(time.Now())
+			}
+			_ = c.Close()
+			closedCount++
+		}
+	}
+	if closedCount > 0 {
+		log.Warnln("Fallback[%s]: closed %d stalled connections on demoted proxy %s", f.Name(), closedCount, proxy.Name())
+	}
+}
+
+func (f *Fallback) findProbePeer(excludeName string) C.Proxy {
+	proxies := f.GetProxies(false)
+	now := time.Now()
+
+	f.stateMux.Lock()
+	defer f.stateMux.Unlock()
+
+	var fallbackPeer C.Proxy
+	for _, p := range proxies {
+		if p.Name() == excludeName || isSkippableAdapter(p.Type()) {
+			continue
+		}
+		if !f.isDemotedLocked(p, now) {
+			if p.AliveForTestUrl(f.testUrl) {
+				return p
+			}
+			if fallbackPeer == nil {
+				fallbackPeer = p
+			}
+		} else if fallbackPeer == nil {
+			fallbackPeer = p
+		}
+	}
+	return fallbackPeer
+}
+
+func (f *Fallback) probeProxy(ctx context.Context, proxy C.Proxy) error {
+	expectedStatus, _ := utils.NewUnsignedRanges[uint16](f.expectedStatus)
+	_, err := proxy.URLTest(ctx, f.testUrl, expectedStatus)
+	if err == nil && !proxy.AliveForTestUrl(f.testUrl) {
+		err = errors.New("health response status outside expected range")
+	}
+	return err
+}
+
+func (f *Fallback) probePair(ctx context.Context, self, peer C.Proxy) (errSelf, errPeer error) {
+	if peer == nil {
+		return f.probeProxy(ctx, self), errors.New("peer proxy unavailable")
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		errSelf = f.probeProxy(ctx, self)
+	}()
+	go func() {
+		defer wg.Done()
+		errPeer = f.probeProxy(ctx, peer)
+	}()
+	wg.Wait()
+	return errSelf, errPeer
+}
+
+func (f *Fallback) reportSuspect(proxy C.Proxy, host string, strong bool) {
+	f.reportEvidence(proxy, host, strong, strong)
+}
+
+func (f *Fallback) reportEvidence(proxy C.Proxy, host string, strong, responsePending bool) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	if host == "" {
+		host = "_unknown_"
+	}
+
+	shouldDemoteMultiHost := false
+	shouldProbe := false
+
+	f.stateMux.Lock()
+	st := f.proxyStateLocked(proxy)
+	if st == nil || now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+	if responsePending && host != "_unknown_" {
+		if st.affectedHosts == nil {
+			st.affectedHosts = make(map[string]time.Time)
+		}
+		st.affectedHosts[host] = now
+	}
+
+	// Only strong signals (watchdog stall / reset / timeout) count toward multi-host demotion.
+	// Weak signals (e.g. io.EOF from a dead target site) only trigger at most a comparative probe.
+	if strong {
+		if st.suspectHosts == nil {
+			st.suspectHosts = make(map[string]time.Time)
+		}
+		for h, ts := range st.suspectHosts {
+			if now.Sub(ts) > fallbackHostWindow {
+				delete(st.suspectHosts, h)
+			}
+		}
+		st.suspectHosts[host] = now
+
+		if len(st.suspectHosts) >= fallbackHostThreshold {
+			shouldDemoteMultiHost = true
+		}
+	}
+
+	if !shouldDemoteMultiHost {
+		minGap := f.effectiveProbeGap(strong)
+		switch {
+		case st.probing:
+			st.pendingProbe = true
+			st.pendingStrong = st.pendingStrong || strong
+		case st.lastProbe.IsZero() || now.Sub(st.lastProbe) >= minGap:
+			st.probing = true
+			st.lastProbe = now
+			st.stopProbeTimerLocked()
+			shouldProbe = true
+		default:
+			f.scheduleProbeLocked(st, proxy, st.lastProbe.Add(minGap), strong)
+		}
+	}
+	owner := st
+	f.stateMux.Unlock()
+
+	if shouldDemoteMultiHost {
+		f.demoteProxyIfOwner(proxy, owner, "multiple distinct hosts stalled/failed", false)
+		return
+	}
+
+	if shouldProbe {
+		f.startProbe(proxy, owner)
+	}
+}
+
+func (f *Fallback) scheduleProbeLocked(st *proxyFailState, proxy C.Proxy, due time.Time, strong bool) {
+	st.pendingStrong = st.pendingStrong || strong
+	if st.probeTimer != nil {
+		if !due.Before(st.probeDue) {
+			return
+		}
+		st.probeTimer.Stop()
+	}
+	st.probeDue = due
+	st.probeGen++
+	gen := st.probeGen
+	owner := st
+	p := proxy
+	st.probeTimer = time.AfterFunc(time.Until(due), func() {
+		f.runDeferredProbe(p, owner, gen)
+	})
+}
+
+func (f *Fallback) runDeferredProbe(proxy C.Proxy, owner *proxyFailState, gen uint64) {
+	if proxy == nil {
+		return
+	}
+	name := proxy.Name()
+	now := time.Now()
+
+	f.stateMux.Lock()
+	st, ok := f.proxyStates[name]
+	if !ok || st != owner || st.probeGen != gen || f.proxyStateLocked(proxy) != owner {
+		f.stateMux.Unlock()
+		return
+	}
+	st.probeTimer = nil
+	if now.Before(st.cooldownUntil) {
+		st.pendingProbe = false
+		f.stateMux.Unlock()
+		return
+	}
+	if st.probing {
+		st.pendingProbe = true
+		f.stateMux.Unlock()
+		return
+	}
+	st.probing = true
+	st.pendingProbe = false
+	st.pendingStrong = false
+	st.lastProbe = now
+	f.stateMux.Unlock()
+
+	f.startProbe(proxy, owner)
+}
+
+func (f *Fallback) startProbe(proxy C.Proxy, owner *proxyFailState) {
+	name := proxy.Name()
+	peer := f.findProbePeer(name)
+	go func() {
+		defer func() {
+			f.stateMux.Lock()
+			if st, ok := f.proxyStates[name]; ok && st == owner {
+				st.probing = false
+				if st.pendingProbe && st.probeTimer == nil && !time.Now().Before(st.cooldownUntil) && f.proxyStateLocked(proxy) == owner {
+					st.pendingProbe = false
+					f.scheduleProbeLocked(st, proxy, st.lastProbe.Add(f.effectiveProbeGap(st.pendingStrong)), st.pendingStrong)
+				}
+			}
+			f.stateMux.Unlock()
+		}()
+
+		f.stateMux.Lock()
+		current := f.proxyStates[name] == owner && f.proxyStateLocked(proxy) == owner
+		f.stateMux.Unlock()
+		if !current {
+			return
+		}
+
+		ctx, cancel := context.WithTimeout(context.Background(), f.probeTimeoutForProxy(proxy))
+		defer cancel()
+
+		errSelf, errPeer := f.probePair(ctx, proxy, peer)
+		// Comparative health results apply to the current proxy instance and state owner.
+		if errSelf != nil && errPeer == nil {
+			f.demoteProxyIfOwner(proxy, owner, "comparative URLTest failed while peer ok: "+errSelf.Error(), true)
+		} else if errSelf != nil && f.findAliveProxy(false) != proxy {
+			go f.closeStalledConnectionsForProxy(proxy, owner, true)
+		}
+	}()
+}
+
+func (f *Fallback) recordProxySuccess(proxy C.Proxy, host string) {
+	if host == "" {
+		host = "_unknown_"
+	}
+	if proxy == nil {
+		return
+	}
+
+	now := time.Now()
+	f.stateMux.Lock()
+	defer f.stateMux.Unlock()
+	if st := f.proxyStates[proxy.Name()]; st != nil && st.proxy == proxy {
+		delete(st.affectedHosts, host)
+		if now.Before(st.cooldownUntil) {
+			return
+		}
+		delete(st.suspectHosts, host)
+		if st.backoffLevel > 0 && !st.cooldownUntil.IsZero() && now.Sub(st.cooldownUntil) >= f.effectiveRecoveryWindow() {
+			st.backoffLevel--
+			st.cooldownUntil = now
+		}
+	}
+}
+
+func (f *Fallback) observe(proxy C.Proxy, host string, strong bool, closeTransport func() error) *fallbackObservation {
+	return &fallbackObservation{
+		group:          f,
+		proxy:          proxy,
+		host:           host,
+		stallTimeout:   f.stallTimeoutForProxy(proxy),
+		strongTimeout:  strong,
+		closeTransport: closeTransport,
+		pending:        make(map[string]*fallbackExchange),
+		writes:         make(map[*fallbackWrite]struct{}),
+	}
+}
+
+func (f *Fallback) wrapObservedConn(c C.Conn, proxy C.Proxy, host string) C.Conn {
+	c.AppendToChains(f)
+	if isSkippableAdapter(proxy.Type()) {
+		return c
+	}
+	return &fallbackObserverConn{Conn: c, fallbackObservation: f.observe(proxy, host, true, func() error {
+		_ = c.SetWriteDeadline(time.Now())
+		return c.Close()
+	})}
+}
+
+func (f *Fallback) wrapObservedPacketConn(c C.PacketConn, proxy C.Proxy, metadata *C.Metadata) C.PacketConn {
+	c.AppendToChains(f)
+	if isSkippableAdapter(proxy.Type()) {
+		return c
+	}
+	host := metadataHostKey(metadata)
+	o := f.observe(proxy, host, false, func() error { _ = c.SetWriteDeadline(time.Now()); return c.Close() })
+	o.addresses = make(map[string]string)
+	o.rememberAddress(metadata, host)
+	return &fallbackObserverPacketConn{PacketConn: c, fallbackObservation: o}
 }
 
