+}
+
+func (t *Table) SendPacket(key, target string, packet C.PacketAdapter, maker func() C.PacketSender) (created C.PacketSender) {
+	t.withSenders(key, func(e *entry) {
+		sender := e.senders[target]
+		if sender == nil {
+			created = maker()
+			sender = created
+			e.senders[target] = sender
+			e.active++
+		}
+		sender.Send(packet)
+	})
+	return
+}
+
+// Share joins the ordinary association, or publishes the first ordinary upstream after dialing.
+func (t *Table) Share(key, target string, publish bool, move func(C.PacketSender)) (joined bool) {
+	t.withSenders(key, func(e *entry) {
+		if shared := e.senders[""]; shared != nil {
+			move(shared)
+			e.senders[target] = shared
+			e.active--
+			joined = true
+		} else if publish {
+			e.senders[""] = e.senders[target]
+		}
+	})
+	return
+}
+
+func (t *Table) RetireDestination(key, target string, sender C.PacketSender) {
+	t.withSenders(key, func(e *entry) {
+		if e.senders[target] == sender {
+			delete(e.senders, target)
+		}
+	})
+}
+
+func (t *Table) RemoveSender(key, target string, sender C.PacketSender) {
+	t.withSenders(key, func(e *entry) {
+		e.active--
+		if e.senders[""] == sender {
+			for addr, owner := range e.senders {
+				if owner == sender {
+					delete(e.senders, addr)
+				}
+			}
+		} else if e.senders[target] == sender {
+			delete(e.senders, target)
+		}
+	})
 }
 
